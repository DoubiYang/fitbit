# 复制为 .env.local 后填写。不要提交真实值。
# Google / 数据库 / TOKEN_ENCRYPTION_KEY 都空着时应用保持演示模式。只填一部分会变成「未配置」。SYNC_SECRET 不影响这一点。

POSTGRES_USER=rhythm
POSTGRES_PASSWORD=
POSTGRES_DB=rhythm
# 不要填 DATABASE_URL。Compose 会用上面三项和 POSTGRES_HOST=db 组装连接串。

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

APP_ORIGIN=http://localhost:3000
APP_BASE_PATH=/rhythm

# openssl rand -base64 32
# 必须恰好解码为 32 字节。丢失且没有 PREVIOUS 时必须重新授权。
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# openssl rand -hex 32
# 可选。没有它时应用仍可 OAuth，但 6 小时调度关闭。仅供 Compose 内的 sync worker 调用内部入口，不得暴露给浏览器。
SYNC_SECRET=

# 拍照识图。没有它时仍可手工记餐。不要提交真实值。
DEEPSEEK_APIKEY=
